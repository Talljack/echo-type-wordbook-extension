{
  "manifest_version": 3,
  "name": "Wordbook Collector · 网页生词本",
  "short_name": "网页生词本",
  "version": "0.1.1",
  "description": "在任意网页选词，一键收藏到自定义词书，并自动补全完整释义、常用短语、近反义词和场景例句。",
  "action": {
    "default_popup": "popup.html",
    "default_title": "加入网页生词本",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" }
  },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "background": { "service_worker": "background.js", "type": "module" },
  "options_page": "options.html",
  "permissions": ["activeTab", "contextMenus", "scripting", "storage"],
  "host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"]
}
