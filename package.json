{
  "name": "echo-type-wordbook-extension",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Collect words from any webpage and turn them into rich, portable wordbooks.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false",
    "verify:package": "node scripts/verify-extension-package.mjs",
    "check": "npm run test && npm run typecheck && npm run build && npm run verify:package"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.2",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "vite": "^7.1.3",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/chrome": "^0.1.3",
    "@types/jsdom": "^21.1.7",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
